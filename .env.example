# App Configuration
APP_NAME="AI Viva Voce System"
DEBUG=true
API_V1_STR=/api

# Security / Auth (generate a random secret locally)
SECRET_KEY=replace-with-a-random-local-secret
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# For SQLite (async dev):
DATABASE_URL=sqlite+aiosqlite:///./viva.db
# For PostgreSQL (prod):
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/viva_db

# CORS (comma-separated or JSON list)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Required for all language-model requests. Get a key from https://console.groq.com/.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=45
# Used for automatic audio-capture transcription when browser speech recognition is unavailable.
GROQ_STT_MODEL=whisper-large-v3-turbo
WHISPER_MODEL=base
