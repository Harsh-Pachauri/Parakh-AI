# Parakh AI Backend Environment Configuration

# App Configuration
APP_NAME="Parakh AI"
DEBUG=false
API_V1_STR=/api
ENVIRONMENT=development

# Security / Auth (generate a random secret: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=replace-with-a-random-secure-secret-key-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# For SQLite (async dev):
DATABASE_URL=sqlite+aiosqlite:///./viva.db
# For PostgreSQL (production):
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/viva_db

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Required for all language-model requests. Get an API key from https://console.groq.com/
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=45

# Audio Transcription
# Used for automatic speech-to-text fallback when browser Web Speech API is unavailable
GROQ_STT_MODEL=whisper-large-v3-turbo
WHISPER_MODEL=base

# Storage & Upload Limits (MB)
MAX_UPLOAD_SIZE_MB=25
